      },
      {
        "selector": "AssignmentExpression[left.type='MemberExpression'][left.property.value=/^(innerHTML|outerHTML)$/]",
        "message": "HTML-STRING-WRITE: no innerHTML/outerHTML assignment; use insertAdjacentHTML or the DOM API, user data through esc()."
      },
      {
        "selector": "AssignmentExpression[left.type='MemberExpression'][left.property.type='TemplateLiteral'][left.property.expressions.length=0][left.property.quasis.0.value.cooked=/^(innerHTML|outerHTML)$/]",
        "message": "HTML-STRING-WRITE: no innerHTML/outerHTML assignment; use insertAdjacentHTML or the DOM API, user data through esc()."
      },
      {
        "selector": "CallExpression[callee.property.name=/^(slice|substring|substr)$/][callee.object.type='CallExpression'][callee.object.callee.property.name='toISOString'][arguments.0.value=0][arguments.1.value=10]",
        "message": "UTC-DAY-KEY: toISOString().slice(0, 10) is the UTC day, not the household's; use the helpers in server/utils/timezone.js."
      },
      {
        "selector": "CatchClause CallExpression[callee.property.name='status'][arguments.0.value=500]",
        "message": "LOG-PLUS-500: a catch block answers 500 itself; pass the error on to the central error handler."
      },
      {
        "selector": "CallExpression[callee.property.name='transaction'] > :function[async=true]",
        "message": "TX-ASYNC-FN: db.transaction() needs a synchronous function; the driver throws on a returned promise and rolls back, and code after the first await runs outside the transaction."
      },
      {
        "selector": "CallExpression[callee.property.name='transaction'] > :function:not([async=true]) AwaitExpression",
        "message": "TX-AWAIT-INSIDE: an await inside the db.transaction() body runs after the commit."
      },
      {
        "selector": "CallExpression[callee.property.name='exec'][arguments.0.value=/^\\s*(BEGIN|COMMIT|ROLLBACK|SAVEPOINT|RELEASE)/i]",
        "message": "TX-MANUAL: manual BEGIN/COMMIT/ROLLBACK; use db.transaction()."
      },
      {
        "selector": "CallExpression:matches([callee.property.name=/^(json|send|end)$/], [arguments.0.name='res']) :matches(MemberExpression[property.name=/^(message|stack)$/][object.name=/^([\\w$]*[eE]rr(or)?|e|ex|exc|cause|failure)$/]:not(BinaryExpression[operator=/^[!=]==?$/] > *):not(BinaryExpression[operator=/^[!=]==?$/] > ChainExpression > *), CallExpression[callee.name='String'][arguments.0.name=/^([\\w$]*[eE]rr(or)?|e|ex|exc|cause|failure)$/], CallExpression[callee.property.name='toString'][callee.object.name=/^([\\w$]*[eE]rr(or)?|e|ex|exc|cause|failure)$/], TemplateLiteral > Identifier[name=/^([\\w$]*[eE]rr(or)?|e|ex|exc|cause|failure)$/])",
        "message": "ERROR-TEXT: the text of an exception goes into a response; answer with a fixed English sentence plus `reason`; let an unexpected error reach the central error handler, or throw an HttpError for a 4xx the client may read."
      },
      {
        "selector": "CatchClause CallExpression:matches([callee.property.name=/^(json|send|end)$/], [arguments.0.name='res']) MemberExpression[property.name=/^(message|stack)$/][object.type='Identifier']:not([object.name=/^([\\w$]*[eE]rr(or)?|e|ex|exc|cause|failure)$/]):not(BinaryExpression[operator=/^[!=]==?$/] > *):not(BinaryExpression[operator=/^[!=]==?$/] > ChainExpression > *)",
        "message": "ERROR-TEXT: inside a catch block the text of a caught value goes into a response; answer with a fixed English sentence plus `reason`; let an unexpected error reach the central error handler, or throw an HttpError for a 4xx the client may read."
      },
      {
        "selector": ":matches(VariableDeclaration, ExpressionStatement:has(> AssignmentExpression)):has(:matches(MemberExpression[property.name=/^(message|stack)$/][object.name=/^([\\w$]*[eE]rr(or)?|e|ex|exc|cause|failure)$/]:not(BinaryExpression[operator=/^[!=]==?$/] > *):not(BinaryExpression[operator=/^[!=]==?$/] > ChainExpression > *), CallExpression[callee.name='String'][arguments.0.name=/^([\\w$]*[eE]rr(or)?|e|ex|exc|cause|failure)$/], CallExpression[callee.property.name='toString'][callee.object.name=/^([\\w$]*[eE]rr(or)?|e|ex|exc|cause|failure)$/], TemplateLiteral > Identifier[name=/^([\\w$]*[eE]rr(or)?|e|ex|exc|cause|failure)$/])):not(:has(:function)):not(Program > *) ~ * :matches(CallExpression[callee.property.name=/^(json|send|end)$/] > Identifier.arguments, CallExpression[callee.property.name=/^(json|send|end)$/] > ObjectExpression.arguments > Property[key.name=/^(error|message|detail|details|description|text|msg|hint)$/][value.type='Identifier'])",
