node_modules
.git
.github
.worktrees
.env
.env.*

# Local AI/dev tooling. None of it exists in a fresh clone, but a build from a
# working copy would otherwise bake it into a published image.
.claude
.codex
.agents
.superpowers
.impeccable
.interface-design
graphify-out
.shoot*.mjs
.measure.mjs

# Database files (never include real data in image)
*.db
*.db-shm
*.db-wal
# Secrets the app generates on its first start (server/utils/auto-secrets.js):
# next to the database, so in the project root without DB_PATH and in data/
# with Compose. `**/` because Docker's globs do not cross a slash. data/ is the
# Compose default DATA_DIR and holds the live database itself.
**/.secrets
data/
.nvmrc
.gitignore
.dockerignore

# Documentation (not needed at runtime)
docs/

# Tests. The bare `test-*.js` patterns only ever matched the context root -
# Docker's globs do not cross a slash - so the whole 180-file test/ directory
# shipped in the image until this line was added.
test/
test-*.js
test-*.mjs
coverage/

# Deployment descriptors and store listings (build inputs, not runtime files)
deploy/
templates/
backups/
ca_profile.xml
nginx.conf.example
docker-compose.yml
podman-compose.yml

# Scripts (dev-only)
scripts/
# Exception: the build stage loads every runtime dependency with this script
# and fails the image when one is missing (#2006).
!scripts/check-runtime-deps.mjs
# Exception: the build stage runs `npm run build` (Vite, Phase 1a section D),
# which needs its plugins and the third-party notices.
!scripts/build/
!scripts/build-third-party-notices.mjs

# Build output of a working copy. The build stage makes its own dist/ and the
# runtime stage takes that one (COPY --from=build), which .dockerignore does
# not touch. A dist/ from the working tree is 35 MB with its source maps and
# would be sent to the daemon on every local build (#2636). Vite's manifest
# lives inside it (dist/.vite/), its temp folder under node_modules.
dist/

# Markdown files (README etc.)
*.md
# Exception: the changelog view falls back to this file when api.github.com
# does not answer (#838). Without it in the image, an instance without outbound
# network shows no history at all.
!CHANGELOG.md

# Installer tools (not part of the running app)
tools/
install.sh

# IDE & OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
